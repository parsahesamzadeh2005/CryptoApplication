<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dark_card_background"
    android:padding="24dp">

    <!-- Title: "Sell Bitcoin" -->
    <TextView
        android:id="@+id/txtSellDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sell"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <!-- Available balance line -->
    <TextView
        android:id="@+id/txtAvailableBalance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Available: 0.00000000"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <!-- Amount input -->
    <EditText
        android:id="@+id/etSellAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="numberDecimal"
        android:hint="Enter amount"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="18sp"
        android:padding="12dp"
        android:background="@drawable/dark_card_background"
        android:layout_marginBottom="12dp" />

    <!-- Quick-select percentage buttons -->
    <LinearLayout
        android:id="@+id/layoutQuickSelect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/btn25"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="25%"
            android:backgroundTint="@color/dark_surface_variant"
            android:textColor="@color/purple_secondary"
            android:textSize="13sp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn50"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="50%"
            android:backgroundTint="@color/dark_surface_variant"
            android:textColor="@color/purple_secondary"
            android:textSize="13sp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn75"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="75%"
            android:backgroundTint="@color/dark_surface_variant"
            android:textColor="@color/purple_secondary"
            android:textSize="13sp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn100"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="100%"
            android:backgroundTint="@color/dark_surface_variant"
            android:textColor="@color/purple_secondary"
            android:textSize="13sp"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <!-- Cancel / Sell action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSellCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancel"
            android:backgroundTint="@color/dark_surface_variant"
            android:textColor="@color/text_secondary"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnSellConfirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sell"
            android:backgroundTint="@color/purple_primary"
            android:textColor="@color/text_primary" />

    </LinearLayout>

</LinearLayout>
